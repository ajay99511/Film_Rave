{
  "name": "filmrave",
  "private": true,
  "version": "0.1.0",
  "description": "FilmRave client-server monorepo: owned NestJS API + Next.js web client, sharing a typed contract with the Flutter app.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "api:dev": "pnpm --filter @filmrave/api dev",
    "web:dev": "pnpm --filter @filmrave/web dev",
    "db:generate": "pnpm --filter @filmrave/api prisma:generate",
    "db:migrate": "pnpm --filter @filmrave/api prisma:migrate",
    "db:seed": "pnpm --filter @filmrave/api prisma:seed"
  }
}
