# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS (web client, Flutter web dev).
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
# Local dev uses the docker-compose Postgres. For cloud (Neon recommended),
# paste the pooled connection string here and the DIRECT (non-pooled) one below.
DATABASE_URL="postgresql://filmrave:filmrave@localhost:5432/filmrave?schema=public"
# Used by Prisma Migrate only. Locally, set it equal to DATABASE_URL.
DIRECT_URL="postgresql://filmrave:filmrave@localhost:5432/filmrave?schema=public"

# --- Auth (Google OAuth + JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Google OAuth 2.0 Client ID (Web application) from Google Cloud Console.
# The web client must use this same id as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# --- TMDB catalog ---
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500
