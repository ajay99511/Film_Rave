# Which backend the logged-in app talks to.
#   local (default) — everything persists in the browser (localStorage). No
#                     server needed; great for design/QA before the API exists.
#   http            — talk to the real NestJS API + Socket.IO.
NEXT_PUBLIC_DATA_SOURCE=local

# Base URL of the FilmRave API (owned NestJS server). Only used when
# NEXT_PUBLIC_DATA_SOURCE=http.
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# Google OAuth 2.0 Client ID (Web application). Must match the API's
# GOOGLE_CLIENT_ID. Only needed when NEXT_PUBLIC_DATA_SOURCE=http (demo mode
# uses a one-click local user). Get it from Google Cloud Console → Credentials.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
